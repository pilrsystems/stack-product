{{- 'stack-layers.css' | asset_url | stylesheet_tag -}}

<section class="stack-layers-section">
  <div class="sl-inner">
    <div class="sl-eyebrow">Modular Design</div>
    <h2 class="sl-heading">Your daily stack.<br>One week's supply.</h2>
    <div class="sl-grid">

      <div class="sl-card">
        <div class="sl-card-top">
          <div class="sl-num">01</div>
          <div class="sl-accent" style="--accent: #A89CC4;"></div>
        </div>
        <h3 class="sl-card-title">Base Pill Pod</h3>
        <p class="sl-card-body">Carries a full week of small and medium-sized capsules — organized across 3 compartments for easy access.</p>
        <ul class="sl-card-list">
          <li>Easy Dispense &amp; Loading Mechanism</li>
          <li>Height: 1 in.</li>
          <li>Vitamin D, Zinc, Multivitamins…</li>
        </ul>
      </div>

      <div class="sl-card">
        <div class="sl-card-top">
          <div class="sl-num">02</div>
          <div class="sl-accent" style="--accent: #7AAFC8;"></div>
        </div>
        <h3 class="sl-card-title">Hybrid Pod</h3>
        <p class="sl-card-body">Organize a week's supply of larger pill supplements — or remove the divider for powder storage. Start with one. Stack as many as you need.</p>
        <ul class="sl-card-list">
          <li>2 capsule types or 1 powder? You choose.</li>
          <li>Height: 2 in.</li>
          <li>Fish Oil, Magnesium, Electrolytes, Creatine…</li>
        </ul>
      </div>

      <div class="sl-card">
        <div class="sl-card-top">
          <div class="sl-num">03</div>
          <div class="sl-accent" style="--accent: #8BC8A0;"></div>
        </div>
        <h3 class="sl-card-title">Powder Pod</h3>
        <p class="sl-card-body">Store a full week's supply of your go-to powders. 1 or 10? Stack as many as you'd like.</p>
        <ul class="sl-card-list">
          <li>Includes 5g scooper</li>
          <li>Height: 2.5 in.</li>
          <li>Pre-Workout, Collagen, Greens Powder…</li>
        </ul>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stack Layers",
  "tag": "div",
  "settings": [],
  "presets": [
    {
      "name": "Stack Layers"
    }
  ]
}
{% endschema %}
