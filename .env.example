# Copy to .env for local `netlify dev` testing. In production, set these
# in the Netlify dashboard (Site settings → Environment variables) —
# never commit real values.

# Shopify app must have these scopes:
#   read_orders, read_customers, write_customers, write_discounts
# Access tokens are obtained via the client credentials grant (they
# expire every 24h — claim-review.mjs handles re-exchanging them).
SHOPIFY_STORE_DOMAIN=pilr-2.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Used for CORS on the claim-review function and should match the
# domain claim.html is actually served from.
SITE_ORIGIN=https://pilrsystems.com
